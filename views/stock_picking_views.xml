<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Analytic Distribution to Picking Form -->
    <record id="view_picking_form_analytic" model="ir.ui.view">
        <field name="name">stock.picking.form.analytic</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Add to the main form (header level) -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="analytic_distribution" widget="analytic_distribution" groups="analytic.group_analytic_accounting" options="{'force_applicability': 'optional'}"/>
            </xpath>
            
            <!-- Add to the move_ids tree view (line level) -->
            <xpath expr="//field[@name='move_ids']//field[@name='product_id']" position="after">
                <field name="analytic_distribution" widget="analytic_distribution" groups="analytic.group_analytic_accounting" optional="show" options="{'force_applicability': 'optional'}"/>
            </xpath>
        </field>
    </record>
</odoo>
