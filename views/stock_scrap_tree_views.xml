<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_scrap_tree_view_analytic" model="ir.ui.view">
        <field name="name">stock.scrap.tree.analytic</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="analytic_distribution" widget="analytic_distribution" groups="analytic.group_analytic_accounting" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
