<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Analytic Distribution to Scrap Form -->
    <record id="stock_scrap_form_view_analytic" model="ir.ui.view">
        <field name="name">stock.scrap.form.analytic</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="analytic_distribution" widget="analytic_distribution" groups="analytic.group_analytic_accounting" options="{'force_applicability': 'optional'}"/>
            </xpath>
        </field>
    </record>
</odoo>
