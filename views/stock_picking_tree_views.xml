<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_tree_analytic" model="ir.ui.view">
        <field name="name">stock.picking.tree.analytic</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="analytic_distribution" widget="analytic_distribution" groups="analytic.group_analytic_accounting" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
